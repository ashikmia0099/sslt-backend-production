// hero model 
model Hero {
    id            String     @id @default(uuid())
    postType      BannerType
    title         String?
    shortOverview String?
    image         String?
    createdAt     DateTime   @default(now())
    updatedAt     DateTime   @updatedAt
}

// hero second model 

model BannerSecond {
    id            String            @id @default(uuid())
    ImagePostType ImagePostTypeEnum

    // single image post filed
    Doctor_Name       String?
    Doctor_Position   String?
    Working_place     String?
    Description_Title String?
    Description       String?
    SingleImage       String?

    dynamicDescriptions Json?

    // dual image select filed 
    Choose_Dual_Type_Image_1 String?
    Choose_Dual_Type_Image_2 String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


// mission vission object model 

model MissionVissionObject {
    id                  String     @id @default(uuid())
    postType            BannerType
    Image               String
    Title               String
    Description         String
    dynamicDescriptions Json?
}

// three banner type

model ThreeBanner {
    id            String          @id @default(uuid())
    Selected_type ThreeBannerType
    BannerTitle   String
    Description   String
    Image         String
}

// popular medical desis model 

model PopularMedicalDecis {
